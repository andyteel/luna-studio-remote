{
  "name": "luna-tracking-remote",
  "version": "2.0.0",
  "description": "A local network remote for controlling Universal Audio LUNA from another device.",
  "author": "Andy Teel",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:build": "npm run build",
    "desktop:package": "npm run desktop:build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jzz": "^1.9.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.lunastudioremote.app",
    "productName": "Luna Companion",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "desktop/**/*",
      "desktop-assets/**/*",
      "luna-fonts/**/*",
      "package.json",
      "luna-image-resources/misc/UniversalAudioIcon.png",
      "node_modules/jzz/**/*",
      "node_modules/jazz-midi/**/*"
    ],
    "asarUnpack": [
      "node_modules/jazz-midi/**/*.node"
    ],
    "mac": {
      "icon": "assets_original/logos/apple-icons/lc-apple-icon.icon",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
